# Copia este archivo como .env y llena los valores. NUNCA subas .env a GitHub.

# ⚠️ MANUAL: tu API key de Grok. Si usas la plataforma del reto, créala en tu panel (empieza por pk_)
XAI_API_KEY=

# ⚠️ MANUAL: nombre del modelo de Grok que vas a usar (míralo en console.x.ai / docs.x.ai)
GROK_MODEL=

# ⚠️ MANUAL: URL base de la API. Con la plataforma del reto usa la URL que aparece en tu panel
#    (la de xAI directo, https://api.x.ai/v1, NO funciona con keys pk_)
XAI_BASE_URL=

MAX_ITERACIONES=5

# ---------- S2 · Herramientas ----------
# (opcional) Ruta de la BD SQLite. Vacío = data/insumos.db. Se crea con: python scripts/cargar_bd.py
RUTA_BD=

# (opcional) API pública de la TRM. Vacío = https://www.datos.gov.co/resource/32sa-8pi3.json
TRM_API_URL=

# ⚠️ MANUAL: token del bot de Telegram. En Telegram habla con @BotFather → /newbot →
#    ponle nombre y usuario (debe terminar en "bot") → copia el token que te da (123456:ABC...).
TELEGRAM_BOT_TOKEN=

# ⚠️ MANUAL: tu chat_id. Escríbele cualquier mensaje a tu bot y abre en el navegador
#    https://api.telegram.org/bot<TOKEN>/getUpdates → copia el número de "chat":{"id": ...}
TELEGRAM_CHAT_ID=

# (opcional) segundos máximos de espera para las APIs externas
TIMEOUT_HTTP=10

# Solo para el demo: 1 = consultar_trm usa una URL inválida para simular una caída
SIMULAR_FALLA_TRM=

# ---------- S3 · Datos reales del DANE (SIPSA-Insumos) ----------
# (opcional) URL del Excel de series históricas por municipio. ⚠️ El año final del nombre
#    cambia cada año (…2021-2026.xlsx → …2021-2027.xlsx): si la descarga da 404, actualízala.
SIPSA_URL=
# (opcional) días que dura la copia local del Excel antes de volver a descargarlo
DIAS_ACTUALIZAR_SIPSA=30
# (opcional) hojas a leer, separadas por coma (1.3 = Fertilizantes)
HOJAS_SIPSA=1.3
# (opcional) años que se guardan (2 = el último año con datos y el anterior)
ANIOS_HISTORIA=2
# (opcional) % por mes a partir del cual la tendencia es "comprar ya" o "esperar"
UMBRAL_PCT_MENSUAL=2
# (opcional) meses de atraso a partir de los cuales un dato se marca como desactualizado
MESES_DATO_VIGENTE=3
