# Copia este archivo como .env y llena los valores. NUNCA subas .env a GitHub.

# ⚠️ MANUAL: tu API key de Grok (https://console.x.ai → API Keys)
XAI_API_KEY=

# ⚠️ MANUAL: nombre del modelo de Grok que vas a usar (míralo en console.x.ai / docs.x.ai)
GROK_MODEL=

# ⚠️ MANUAL (opcional): verifica la URL base en la documentación de xAI
XAI_BASE_URL=https://api.x.ai/v1

MAX_ITERACIONES=5

# ---------- S2 · Herramientas ----------
# (opcional) Ruta de la BD SQLite. Vacío = data/insumos.db. Se crea con: python scripts/cargar_bd.py
RUTA_BD=

# (opcional) API pública de la TRM. Vacío = https://www.datos.gov.co/resource/32sa-8pi3.json
TRM_API_URL=

# ⚠️ MANUAL: token del bot de Telegram. En Telegram habla con @BotFather → /newbot →
#    ponle nombre y usuario (debe terminar en "bot") → copia el token que te da (123456:ABC...).
TELEGRAM_BOT_TOKEN=

# ⚠️ MANUAL: tu chat_id. Escríbele cualquier mensaje a tu bot y abre en el navegador
#    https://api.telegram.org/bot<TOKEN>/getUpdates → copia el número de "chat":{"id": ...}
TELEGRAM_CHAT_ID=

# (opcional) segundos máximos de espera para las APIs externas
TIMEOUT_HTTP=10

# Solo para el demo: 1 = consultar_trm usa una URL inválida para simular una caída
SIMULAR_FALLA_TRM=
